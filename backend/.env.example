# Deep Research Analysis — Environment Variables
# Copy this file to backend/.env and fill in your keys

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/deep_research?retryWrites=true&w=majority

# Google Gemini API key (get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Tavily Search API key (get from https://app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Semantic Scholar API key — optional but removes rate limits
# (get from https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=

# Gemini model to use — gemini-2.0-flash is recommended for speed+quality
GEMINI_MODEL=gemini-2.0-flash